// Cloudflare dağıtım yapılandırması.
//
// NEDEN GEREKLİ: Cloudflare'in yeni akışı derlemeden sonra `npx wrangler deploy` çalıştırıyor.
// Klasik Pages akışının aksine burada "çıktı klasörü" diye bir panel ayarı YOK; wrangler
// nereyi yayınlayacağını yalnız bu dosyadan öğrenir. Dosya olmadan dağıtım "başarılı" görünür
// ama site kök dizin dahil her adreste 404 döner (birebir bu yaşandı).
{
  // Worker'ın adı. Cloudflare'deki mevcut projeyle BİREBİR AYNI olmalı; farklı yazılırsa
  // ikinci bir Worker oluşur ve site yine boş kalır.
  "name": "cloudposgrid-frontend",

  // Yalnızca davranış bayraklarını sabitler. Geçmiş bir tarih güvenlidir; İLERİ tarih
  // wrangler tarafından reddedilir.
  "compatibility_date": "2025-09-01",

  "assets": {
    // Angular çıktısı "browser" ALT KLASÖRÜNE yazar (dist/cloudposgrid değil).
    // Bir üst klasörü göstermek en sık yapılan hata: derleme yeşil, site boş.
    "directory": "./dist/cloudposgrid/browser",

    // SPA geri-dönüşü: /stok/urunler gibi derin bağlantılar sunucuda dosya olarak yoktur.
    // Bu ayar olmadan sayfa yenilendiğinde ya da tanıtım sitesinden /giris'e gelindiğinde
    // 404 alınır. Gerçek dosyalar (JS, ikonlar, manifest) önce eşleştiği için bu kural
    // yalnız eşleşmeyen yollarda devreye girer.
    //
    // ⚠️ public/_redirects DOSYASINI GERİ EKLEME. Klasik Pages/Netlify'da SPA geri-dönüşü
    // "/*  /index.html  200" satırıyla yazılır; Workers akışı bu dosyayı da okur ama o kuralı
    // REDDEDER ve dağıtımı komple başarısız kılar: Workers zaten "/index" ve ".html" eklerini
    // kendisi kırptığı için kural kendi kendini tetikler ("Infinite loop detected", code 100324).
    // Aynı işi aşağıdaki ayar yapıyor; iki mekanizma birlikte kullanılamaz.
    "not_found_handling": "single-page-application"
  }
}
